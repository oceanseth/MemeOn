{
  "manifest_version": 3,
  "name": "MemeOn!",
  "version": "0.1.0",
  "description": "Hover over an image, press Alt+Shift+M, and bring it to your MemeOn mint desk.",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MemeOn! \u00e2\u20ac\u201d hover an image and press Alt+Shift+M"
  },
  "icons": {
    "32": "icons/brain-32.png",
    "48": "icons/brain-48.png",
    "128": "icons/brain-128.png"
  },
  "commands": {
    "memeon-image": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Show MemeOn! for the image under the pointer"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["config.js", "shared.js", "content.js", "bridge.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/brain-48.png"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ]
}
