{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "web": {
      "entry": [
        "src/**/*.stories.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "scripts/*.mjs",
        ".storybook/**/*.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx,css,mdx}",
        "scripts/**/*.mjs"
      ],
      "ignoreExportsUsedInFile": true
    }
  }
}
