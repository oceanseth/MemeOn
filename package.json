{
  "name": "memeon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=memeon-api",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=memeon-api",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build": "turbo run build package --filter=web --filter=memeon-api",
    "build:web": "turbo run build --filter=web",
    "bundle:api": "turbo run package --filter=memeon-api",
    "check": "turbo run check --filter=web",
    "typecheck": "turbo run typecheck --filter=web --filter=memeon-api --filter=mobile",
    "test": "turbo run test --filter=web",
    "storybook": "turbo run storybook --filter=web",
    "build-storybook": "turbo run build-storybook --filter=web",
    "mobile:export": "pnpm --filter mobile export:ios",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "knip": "^6.35.1",
    "prettier": "^3.3.3",
    "turbo": "2.10.12"
  }
}
